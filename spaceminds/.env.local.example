# Supabase — get from supabase.com > project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Google Sheets — the master sheet ID (from the URL)
# https://docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=YOUR_SHEET_ID

# Google Service Account (for two-way sync)
# Create at console.cloud.google.com > APIs > Credentials > Service Account
# Download JSON key, paste the fields below
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
